{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/openwdl/wdl/wdl-1.4/modules/schemas/module-lock.schema.json",
  "title": "WDL Module Lockfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "dependencies"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "dependencies": { "$ref": "#/$defs/dependencyMap" }
  },
  "$defs": {
    "dependencyMap": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
      "additionalProperties": { "$ref": "#/$defs/dependencyEntry" }
    },
    "dependencyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "dependencies"],
      "properties": {
        "source": { "$ref": "#/$defs/source" },
        "checksum": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "signer": { "type": "string", "pattern": "^ssh-ed25519 [A-Za-z0-9+/]+=*( .*)?$" },
        "dependencies": { "$ref": "#/$defs/dependencyMap" }
      },
      "if": {
        "properties": { "source": { "$ref": "#/$defs/gitSource" } },
        "required": ["source"]
      },
      "then": { "required": ["checksum"] },
      "else": {
        "not": {
          "anyOf": [{ "required": ["checksum"] }, { "required": ["signer"] }]
        }
      }
    },
    "gitSelector": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["version"],
          "properties": { "version": { "type": "string" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tag"],
          "properties": { "tag": { "type": "string" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["branch"],
          "properties": { "branch": { "type": "string" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["commit"],
          "properties": { "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" } }
        }
      ]
    },
    "gitSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git", "sha", "selector"],
      "properties": {
        "git": { "type": "string", "format": "uri" },
        "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "selector": { "$ref": "#/$defs/gitSelector" },
        "path": { "type": "string" }
      }
    },
    "pathSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": { "path": { "type": "string" } }
    },
    "source": {
      "oneOf": [{ "$ref": "#/$defs/gitSource" }, { "$ref": "#/$defs/pathSource" }]
    }
  }
}
